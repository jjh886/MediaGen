{
  "name": "mediagen",
  "private": true,
  "version": "0.1.0",
  "description": "OpenAI-compatible media generation service with a local web console.",
  "type": "module",
  "workspaces": [
    "apps/console",
    "packages/contracts",
    "packages/ui",
    "packages/feature-kits"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "npm run dev:console",
    "dev:console": "npm --workspace @mediagen/console run dev",
    "dev:server": "cargo run -p mediagen-server",
    "dev:launcher": "cargo run -p mediagen-local-launcher",
    "build": "npm run build:console && npm run build:server && npm run build:launcher",
    "build:console": "npm --workspace @mediagen/console run build",
    "build:server": "cargo build -p mediagen-server --release",
    "build:launcher": "cargo build -p mediagen-local-launcher --release",
    "package:local": "node scripts/package-local-release.mjs",
    "package:installers": "node scripts/package-local-installers.mjs",
    "type-check": "npm --workspace @mediagen/console run type-check",
    "lint": "node scripts/check-code-line-limit.mjs --scope app --max 500 && node scripts/check-import-boundaries.mjs && node scripts/check-rust-platform-boundaries.mjs && npm --workspace @mediagen/console run lint",
    "test": "npm --workspace @mediagen/console run test",
    "test:watch": "npm --workspace @mediagen/console run test -- --watch",
    "coverage:gate": "node scripts/gates/check-coverage-gate.mjs --app",
    "check": "npm run type-check && npm run lint && npm run test && npm run build && npm run cargo-check",
    "cargo-check": "cargo check --workspace",
    "cargo-test": "cargo test --workspace",
    "format:check": "node scripts/check-prettier-format.mjs --all",
    "quality:start": "node scripts/gates/run-start-quality-gate.mjs",
    "quality:semgrep": "node scripts/run-semgrep-local.mjs",
    "preflight": "make preflight",
    "check:compat-expiry": "bash scripts/check-compat-expiry.sh"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2"
  }
}
