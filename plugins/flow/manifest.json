{
  "platform_id": "flow",
  "display_name": "Flow",
  "sort_order": 10,
  "adapter_mode": "browser",
  "browser_lifecycle": "persistent",
  "login_url": "https://labs.google/fx/zh/tools/flow/",
  "workspace_url": "https://labs.google/fx/zh/tools/flow/",
  "models": [
    {
      "model_id": "flow_Nano_Banana_Pro",
      "display_name": "Nano Banana Pro",
      "task_kind": "image"
    },
    {
      "model_id": "flow_Nano_Banana_2",
      "display_name": "Nano Banana 2",
      "task_kind": "image"
    },
    {
      "model_id": "flow_Imagen_4",
      "display_name": "Imagen 4",
      "task_kind": "image"
    }
  ],
  "tiers": {
    "free": {
      "display_name": "免费用户",
      "is_default": true,
      "concurrency_limit": 1,
      "daily_limit": 50,
      "total_limit": 0,
      "cooldown_seconds": 30
    }
  },
  "login_detection": {
    "method": "js_script",
    "script_file": "check_login.js",
    "await_promise": true
  },
  "login_check": {
    "url": "https://labs.google/fx/api/auth/session",
    "cookie_domain": "google",
    "success_field": "user.email",
    "expires_field": "expires"
  },
  "watermark": {
    "has_watermark": false,
    "removal_strategy": "none"
  },
  "flows": {
    "generate_image": {
      "steps": [
        {
          "_comment": "1. 启动/复用浏览器（persistent + headless=new：登录态由 profile SQLite 恢复，任务阶段窗口对用户不可见）",
          "action": "browser.open",
          "profile_dir": "{{profile_dir}}",
          "chrome_path": "{{chrome_path}}",
          "headless": true,
          "restore_url": "https://labs.google/fx/zh/tools/flow/",
          "save_as": "browser"
        },
        {
          "_comment": "2. 导航到 Flow 首页",
          "action": "browser.navigate",
          "session_id": "{{browser.session_id}}",
          "url": "https://labs.google/fx/zh/tools/flow/",
          "wait_ms": 8000,
          "save_as": "nav"
        },
        {
          "_comment": "3. 查找项目或新建（等待项目列表加载，最多 10 秒）",
          "action": "browser.run_script",
          "session_id": "{{browser.session_id}}",
          "script_file": "find_project.js",
          "await_promise": true,
          "save_as": "page_check"
        },
        {
          "_comment": "4. 导航到项目页面",
          "action": "browser.navigate",
          "session_id": "{{browser.session_id}}",
          "url": "{{page_check.project_url}}",
          "wait_ms": 5000,
          "save_as": "nav_project",
          "skip_if_empty": true
        },
        {
          "_comment": "5. 等待项目页面 textbox 出现",
          "action": "browser.run_script",
          "session_id": "{{browser.session_id}}",
          "script": "(() => { return new Promise((resolve) => { let tries = 0; const check = () => { tries++; const tb = document.querySelector('div[role=\"textbox\"][contenteditable=\"true\"]'); if (tb) { resolve(JSON.stringify({ready: true, tries})); return; } if (tries > 20) { resolve(JSON.stringify({ready: false, error: '项目页面加载超时'})); return; } setTimeout(check, 500); }; check(); }); })()",
          "await_promise": true,
          "save_as": "page_ready"
        },
        {
          "_comment": "6. 注入参数（模型名、比例、数量、参考图 data URLs）到 window.__frame64_params",
          "action": "browser.run_script",
          "session_id": "{{browser.session_id}}",
          "script": "window.__frame64_params = { model_display_name: '{{js:model_display_name}}', ratio: '{{js:image_aspect_ratio}}', count: {{max_images}}, ref_image_dataurls: JSON.parse('{{js:ref_image_dataurls}}' || '[]') }; JSON.stringify({set: true, refs: window.__frame64_params.ref_image_dataurls.length})",
          "save_as": "params_set"
        },
        {
          "_comment": "7. 选择模型/比例/数量（Radix 菜单需要 pointer events）",
          "action": "browser.run_script",
          "session_id": "{{browser.session_id}}",
          "script_file": "select_params.js",
          "await_promise": true,
          "save_as": "params_selected"
        },
        {
          "_comment": "8. 把所有参考图通过 paste 事件粘贴到 textbox，Flow 前端监听 paste 识别为参考图（支持多张）",
          "action": "browser.run_script",
          "session_id": "{{browser.session_id}}",
          "script_file": "paste_references.js",
          "await_promise": true,
          "save_as": "refs_pasted"
        },
        {
          "_comment": "9. 等待 Flow 前端完成参考图上传（每张约 1-2 秒）",
          "action": "browser.run_script",
          "session_id": "{{browser.session_id}}",
          "script": "(() => new Promise(r => setTimeout(() => r(JSON.stringify({w:1})), 3000)))()",
          "await_promise": true,
          "save_as": "w_ref"
        },
        {
          "_comment": "11. 安装 fetch/XHR 拦截器（必须在提交前，捕获 batchGenerateImages 和 uploadImage）",
          "action": "browser.run_script",
          "session_id": "{{browser.session_id}}",
          "script_file": "setup_interceptor.js",
          "save_as": "interceptor"
        },
        {
          "_comment": "12. 通过 CDP 键盘事件输入 prompt（聚焦 Slate 编辑器后逐字输入，模拟真实键盘）",
          "action": "browser.type_text",
          "session_id": "{{browser.session_id}}",
          "selector": "div[role=\"textbox\"][contenteditable=\"true\"]",
          "text": "{{prompt}}",
          "clear_first": true,
          "save_as": "typed"
        },
        {
          "_comment": "13. 等待 500ms 确保输入已提交到 Slate",
          "action": "browser.run_script",
          "session_id": "{{browser.session_id}}",
          "script": "(() => new Promise(r => setTimeout(() => r(JSON.stringify({w:1})), 500)))()",
          "await_promise": true,
          "save_as": "w_submit"
        },
        {
          "_comment": "14. 点击提交按钮（CDP 鼠标点击包含 arrow_forward 的按钮）",
          "action": "browser.click_text",
          "session_id": "{{browser.session_id}}",
          "text": "arrow_forward",
          "tag": "i",
          "save_as": "submit"
        },
        {
          "_comment": "16. 轮询等待生成结果（600 秒超时，拦截器捕获 fifeUrl）",
          "action": "browser.poll_script",
          "session_id": "{{browser.session_id}}",
          "script_file": "generate_image_poll.js",
          "until": "status == 'done'",
          "interval_ms": 3000,
          "timeout_ms": 600000,
          "save_as": "poll_result"
        },
        {
          "_comment": "17. 下载生成的图片（fifeUrl 是 GCS 签名直链）",
          "action": "http.download",
          "url": "{{poll_result.url}}",
          "save_as": "local_file"
        },
        {
          "_comment": "18. 清理：下载完成后删除项目中的参考图和生成结果",
          "action": "browser.run_script",
          "session_id": "{{browser.session_id}}",
          "script_file": "cleanup.js",
          "await_promise": true,
          "save_as": "cleanup"
        },
        {
          "_comment": "19. 释放 session 占用但保留 Chrome 常驻（persistent 模式）",
          "action": "browser.close",
          "session_id": "{{browser.session_id}}"
        }
      ]
    }
  },
  "registration": {
    "enabled": false
  }
}
