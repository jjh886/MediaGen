{
  "platform_id": "doubaowork-api",
  "display_name": "Doubao Work API",
  "sort_order": 42,
  "adapter_mode": "api",
  "login_url": "https://www.doubao.com/chat/",
  "workspace_url": "https://www.doubao.com/chat/",
  "models": [
    {
      "model_id": "doubaowork-seedream-5.0-pro",
      "display_name": "Seedream 5.0 Pro",
      "task_kind": "image",
      "aliases": ["seedream-5.0-pro"],
      "alias_priority": 10
    },
    {
      "model_id": "doubaowork-seedance-2.5",
      "display_name": "Seedance 2.5",
      "task_kind": "video",
      "aliases": ["seedance-2.5"],
      "alias_priority": 10
    }
  ],
  "tiers": {
    "pro": {
      "display_name": "专业版",
      "is_default": true,
      "concurrency_limit": 1,
      "daily_limit": 0,
      "total_limit": 0,
      "cooldown_seconds": 60,
      "task_interval_seconds": 5
    }
  },
  "image_capabilities": {
    "supports_generation": true,
    "supports_edit": true,
    "supports_mask": false,
    "max_reference_images": 16,
    "supported_output_formats": ["png", "jpeg", "webp"]
  },
  "video_capabilities": {
    "supports_generation": true,
    "supports_image_reference": true,
    "max_reference_images": 4,
    "default_duration_seconds": 5,
    "default_size": "720x1280",
    "supported_aspect_ratios": ["16:9", "4:3", "1:1", "3:4", "9:16", "21:9"],
    "min_duration_seconds": 5,
    "max_duration_seconds": 30,
    "output_format": "mp4"
  },
  "generation_settings": {
    "title": "Doubao Work 生成配置",
    "description": "图片固定使用 Seedream 5.0 Pro，视频固定使用 Seedance 2.5；任务由本机 Doubao Work App 原生页面提交。",
    "notice": "首次运行会自动尝试以 CDP 调试模式启动 Doubao Work。若 App 已普通启动，请先退出后重试。出现“全部允许”时必须由你本人在 App 中确认。",
    "fields": []
  },
  "failure_strategy": [
    {
      "contains_any": ["710022004", "需要完成风控验证", "rate limited"],
      "category": "verification_required",
      "retry_action": "failover",
      "account_state": "verification_required",
      "usage_consumed": false
    },
    {
      "contains_any": ["未认证人脸", "出于肖像保护考虑", "我暂时无法生成", "拒绝了本次媒体生成"],
      "category": "content_policy",
      "retry_action": "fail",
      "usage_consumed": false
    },
    {
      "contains_any": [
        "没有 Seedream 5.0 Pro 权限",
        "没有 Seedance 2.5 权限",
        "当前账号暂未开通会员",
        "当前账号暂不支持"
      ],
      "category": "quota_exhausted",
      "retry_action": "failover",
      "account_state": "total_quota_exhausted",
      "usage_consumed": false
    },
    {
      "contains_any": ["额度用完", "quota", "频繁"],
      "category": "quota_exhausted",
      "retry_action": "failover",
      "account_state": "daily_quota_exhausted",
      "cooldown_from_message": true,
      "usage_consumed": false
    },
    {
      "contains_any": ["服务过载", "稍后重试", "服务繁忙", "生成超时"],
      "category": "platform_busy",
      "retry_action": "same_account_retry",
      "same_error_threshold": 2,
      "threshold_cooldown_seconds": 600,
      "usage_consumed": false
    }
  ],
  "verification": {
    "trigger_contains_any": ["710022004", "需要完成风控验证"],
    "ignore_contains_any": [],
    "captcha_selectors": [],
    "timeout_seconds": 600
  },
  "login_detection": {
    "method": "js_script",
    "script_file": "check_login.js",
    "await_promise": false
  },
  "login_check": {
    "url": "https://www.doubao.com/passport/account/info/v2/?aid=1044603&account_sdk_source=web",
    "cookie_domain": "doubao.com",
    "success_field": "data.avatar_url",
    "inconclusive_statuses": [403, 429, 500, 502, 503, 504]
  },
  "watermark": {
    "has_watermark": true,
    "removal_strategy": "none"
  },
  "flows": {
    "generate_image": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["external_ui.js", "generate_image_external.js"],
          "timeout_ms": 900000,
          "save_as": "result"
        }
      ]
    },
    "generate_video": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["external_ui.js", "generate_video_external.js"],
          "timeout_ms": 1200000,
          "save_as": "result"
        }
      ]
    }
  }
}
