{
  "schema_version": 1,
  "adapter_mode": "api",
  "failure_strategy": [
    {
      "contains_any": ["verification_required", "needs_verification"],
      "category": "verification_required",
      "retry_action": "failover",
      "account_state": "verification_required",
      "usage_consumed": false
    },
    {
      "contains_any": ["verification_required"],
      "category": "verification_required",
      "retry_action": "fail",
      "account_state": "verification_required",
      "usage_consumed": false
    },
    {
      "contains_any": [
        "missing_input",
        "generation_requires_confirmation",
        "invalid_input",
        "unsupported_speed",
        "unsupported_instructions",
        "unsupported_voice",
        "unsupported_format"
      ],
      "category": "invalid_request",
      "retry_action": "fail",
      "usage_consumed": false
    },
    {
      "contains_any": ["LOGIN_EXPIRED", "HTTP 401"],
      "category": "login_expired",
      "retry_action": "failover",
      "account_state": "login_expired",
      "usage_consumed": false
    },
    {
      "contains_any": ["rate_limit_exceeded", "HTTP 429", "生成过于频繁"],
      "category": "account_rate_limited",
      "retry_action": "failover",
      "account_state": "cooldown",
      "cooldown_from_message": true,
      "cooldown_seconds": -1,
      "usage_consumed": false
    },
    {
      "contains_any": [
        "quota_exhausted",
        "image generations requests",
        "limit resets in",
        "usage limit",
        "insufficient_quota",
        "limit exceeded"
      ],
      "category": "quota_exhausted",
      "retry_action": "failover",
      "account_state": "daily_quota_exhausted",
      "cooldown_from_message": true,
      "cooldown_seconds": -1,
      "usage_consumed": false
    },
    {
      "contains_any": [
        "AUTH_INCONCLUSIVE",
        "generation_timeout",
        "temporary_unavailable",
        "timeout",
        "connection reset",
        "HTTP 500",
        "HTTP 502",
        "HTTP 503",
        "HTTP 504"
      ],
      "category": "transient_network",
      "retry_action": "same_account_retry",
      "same_error_threshold": 3,
      "threshold_cooldown_seconds": 600,
      "usage_consumed": false
    }
  ],
  "verification": {
    "trigger_contains_any": [],
    "ignore_contains_any": [],
    "captcha_selectors": []
  },
  "registration": {
    "enabled": false
  },
  "version": "2.0.0",
  "platform_id": "doubao-api",
  "display_name": "豆包",
  "sort_order": 50,
  "login_url": "https://www.doubao.com/chat/",
  "workspace_url": "https://www.doubao.com/chat/",
  "capabilities": {
    "actions": [
      "browser.run_script",
      "file.read_json",
      "file.write_json",
      "http.request",
      "http.sse_request",
      "time.sleep",
      "http.download",
      "file.write_base64",
      "file.read_base64",
      "file.inspect_image",
      "file.inspect_media",
      "crypto.base64_encode_latin1",
      "crypto.base64_decode_latin1",
      "crypto.base64_encode_utf8",
      "crypto.digest_bytes",
      "crypto.hmac_sha256"
    ],
    "network_hosts": [
      "doubao.com",
      "vodupload.com",
      "byteimg.com",
      "doubaopic.com",
      "douyinvod.com",
      "bytevcloud.com",
      "ibytedtos.com",
      "snssdk.com",
      "bytedancevod.com",
      "mssdk.bytedance.com"
    ],
    "context_fields": [
      "profile_dir",
      "workspace_dir",
      "request",
      "model_id",
      "model_capabilities",
      "reasoning_effort",
      "prompt",
      "platform_config",
      "image_aspect_ratio",
      "video_aspect_ratio",
      "generation_options",
      "ref_image_dataurls",
      "ref_image_locals",
      "ref_video_locals",
      "ref_audio_locals",
      "video_duration",
      "max_images",
      "seconds",
      "duration"
    ]
  },
