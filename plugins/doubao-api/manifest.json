            "auth.js",
            "signing_transport.js",
            "signing_environment.js",
            "signing.js",
            "lifecycle.js",
            "conversation.js",
            "history.js",
            "upload.js",
            "media_options.js",
            "generate_image.js"
          ],
          "timeout_ms": 14400000,
          "save_as": "result"
        }
      ]
    },
    "generate_video": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": [
            "@shared/api_session.js",
            "@shared/api_text_attachments.js",
            "@shared/api_text_responses.js",
            "auth.js",
            "signing_transport.js",
            "signing_environment.js",
            "signing.js",
            "lifecycle.js",
            "conversation.js",
            "history.js",
            "upload.js",
            "media_options.js",
            "video_upload.js",
            "generate_video.js"
          ],
          "timeout_ms": 14400000,
          "save_as": "result"
        }
      ]
    },
    "check_account": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": [
            "@shared/api_session.js",
            "@shared/api_text_attachments.js",
            "@shared/api_text_responses.js",
            "auth.js",
            "signing_transport.js",
            "signing_environment.js",
            "signing.js",
            "check_account.js"
          ],
          "timeout_ms": 120000,
          "save_as": "health"
        }
      ]
    }
  },
  "watermark": {
    "has_watermark": false,
    "removal_strategy": "none"
