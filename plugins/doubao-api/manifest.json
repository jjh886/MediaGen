{
  "platform_id": "doubao-api",
  "display_name": "豆包 API",
  "sort_order": 41,
  "adapter_mode": "browser",
  "browser_lifecycle": "persistent",
  "login_url": "https://www.doubao.com/chat/",
  "workspace_url": "https://www.doubao.com/chat/",
  "models": [
    {
      "model_id": "doubao-image",
      "display_name": "豆包图片生成",
      "task_kind": "image"
    },
    {
      "model_id": "doubao-video",
      "display_name": "Seedance 2.0",
      "task_kind": "video"
    }
  ],
  "tiers": {
    "free": {
      "display_name": "免费用户",
      "is_default": true,
      "concurrency_limit": 1,
      "daily_limit": 0,
      "total_limit": 0,
      "cooldown_seconds": 30,
      "task_interval_seconds": 5
    }
  },
  "image_capabilities": {
    "supports_generation": true,
    "supports_edit": true,
    "supports_mask": false,
    "max_reference_images": 1,
    "supported_output_formats": ["png", "jpeg", "webp"]
  },
  "video_capabilities": {
    "supports_generation": true,
    "supports_image_reference": true,
    "max_reference_images": 1,
    "default_duration_seconds": 5,
    "supported_seconds": ["5"],
    "default_size": "1280x720",
    "supported_aspect_ratios": ["16:9", "9:16", "1:1"],
    "max_duration_seconds": 15,
    "output_format": "mp4"
  },
  "failure_strategy": [
    {
      "contains_any": ["710022004", "需要验证", "captcha"],
      "category": "verification_required",
      "retry_action": "failover",
      "account_state": "verification_required",
      "usage_consumed": false
    },
    {
      "contains_any": ["额度", "limit", "rate", "频繁"],
      "category": "quota_exhausted",
      "retry_action": "failover",
      "account_state": "daily_quota_exhausted",
      "cooldown_from_message": true,
      "usage_consumed": false
    },
    {
      "contains_any": ["服务过载", "稍后重试", "服务繁忙"],
      "category": "platform_busy",
      "retry_action": "same_account_retry",
      "same_error_threshold": 3,
      "threshold_cooldown_seconds": 600,
      "usage_consumed": false
    },
    {
      "contains_any": ["无法生成", "内容违规", "平台拒绝"],
      "category": "content_policy",
      "retry_action": "fail",
      "usage_consumed": false
    }
  ],
  "verification": {
    "trigger_contains_any": ["710022004", "需要验证"],
    "ignore_contains_any": [],
    "captcha_selectors": [".vc-captcha-verify-visibility"],
    "timeout_seconds": 600
  },
  "login_detection": {
    "method": "js_script",
    "script_file": "check_login.js",
    "await_promise": false
  },
  "login_check": {
    "url": "https://www.doubao.com/passport/account/info/v2/?aid=497858&account_sdk_source=web&sdk_version=2.2.11-doubao.0",
    "cookie_domain": "doubao.com",
    "success_field": "data.avatar_url",
    "inconclusive_statuses": [403, 429, 500, 502, 503, 504]
  },
  "watermark": {
    "has_watermark": true,
    "removal_strategy": "none"
  },
  "flows": {
    "generate_image": {
      "steps": [
        {
          "action": "browser.open",
          "profile_dir": "{{profile_dir}}",
          "headless": true,
          "restore_url": "https://www.doubao.com/",
          "save_as": "browser"
        },
        {
          "action": "browser.navigate",
          "session_id": "{{browser.session_id}}",
          "url": "https://www.doubao.com/chat/",
          "wait_ms": 5000,
          "save_as": "navigation"
        },
        {
          "action": "browser.run_script",
          "session_id": "{{browser.session_id}}",
          "script": "(() => { window[Symbol.for('mediagen.doubao.api')] = { prompt: '{{js:prompt}}', image_aspect_ratio: '{{js:image_aspect_ratio}}', ref_image_dataurls: JSON.parse('{{js:ref_image_dataurls}}' || '[]') }; return { configured: true }; })()",
          "save_as": "parameters"
        },
        {
          "action": "browser.run_script",
          "session_id": "{{browser.session_id}}",
          "script_files": ["@shared/doubao_internal_api.js", "config.js", "generate_image.js"],
          "await_promise": true,
          "timeout_ms": 240000,
          "save_as": "result"
        },
        {
          "action": "browser.close",
          "session_id": "{{browser.session_id}}",
          "profile_dir": "{{profile_dir}}"
        }
      ]
    },
    "generate_video": {
      "steps": [
        {
          "action": "browser.open",
          "profile_dir": "{{profile_dir}}",
          "headless": true,
          "restore_url": "https://www.doubao.com/",
          "save_as": "browser"
        },
        {
          "action": "browser.navigate",
          "session_id": "{{browser.session_id}}",
          "url": "https://www.doubao.com/chat/",
          "wait_ms": 5000,
          "save_as": "navigation"
        },
        {
          "action": "browser.run_script",
          "session_id": "{{browser.session_id}}",
          "script": "(() => { window[Symbol.for('mediagen.doubao.api')] = { prompt: '{{js:prompt}}', video_aspect_ratio: '{{js:video_aspect_ratio}}', ref_image_dataurls: JSON.parse('{{js:ref_image_dataurls}}' || '[]'), generation_options: JSON.parse('{{js:generation_options}}' || '{}') }; return { configured: true }; })()",
          "save_as": "parameters"
        },
        {
          "action": "browser.run_script",
          "session_id": "{{browser.session_id}}",
          "script_files": ["@shared/doubao_internal_api.js", "config.js", "generate_video.js"],
          "await_promise": true,
          "timeout_ms": 720000,
          "save_as": "result"
        },
        {
          "action": "browser.close",
          "session_id": "{{browser.session_id}}",
          "profile_dir": "{{profile_dir}}"
        }
      ]
    }
  }
}
