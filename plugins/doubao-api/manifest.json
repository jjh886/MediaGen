  "tiers": {
    "free": {
      "display_name": "默认用户",
      "is_default": true,
      "concurrency_limit": 1,
      "daily_limit": 0,
      "total_limit": 0,
      "text_concurrency_limit": 1,
      "text_daily_limit": 0,
      "text_total_limit": 0,
      "cooldown_seconds": 30,
      "task_interval_seconds": 3
    }
  },
  "login_detection": {
    "method": "js_script",
    "script_files": ["config.js", "check_login.js"],
    "context_file": "verification.json",
    "await_promise": true
  },
  "login_credential_capture": {
    "script_files": ["@shared/api_login_fingerprint.js", "config.js", "capture_auth.js"],
    "await_promise": true,
    "file_name": "auth.json",
    "cookie_urls": ["https://www.doubao.com/chat/", "https://accounts.doubao.com/"]
  },
  "flows": {
    "generate_text": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": [
            "@shared/api_session.js",
            "@shared/api_text_attachments.js",
            "@shared/api_text_responses.js",
            "auth.js",
            "signing_transport.js",
            "signing_environment.js",
            "signing.js",
            "lifecycle.js",
            "conversation.js",
            "history.js",
            "upload.js",
            "generate_text.js"
          ],
          "timeout_ms": 14400000,
          "save_as": "result"
        }
      ]
    },
    "generate_image": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": [
            "@shared/api_session.js",
