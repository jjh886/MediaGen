  "tiers": {
    "free": {
      "display_name": "默认用户",
      "is_default": true,
      "concurrency_limit": 2,
      "daily_limit": 40,
      "total_limit": 0,
      "cooldown_seconds": 30,
      "task_interval_seconds": 0,
      "text_concurrency_limit": 0,
      "text_daily_limit": 0,
      "text_total_limit": 0
    }
  },
  "image_capabilities": {
    "supports_generation": true,
    "supports_edit": true,
    "supports_mask": false,
    "max_reference_images": 16,
    "supported_output_formats": ["png", "jpeg", "webp"],
    "supports_variation": false,
    "streaming": true,
    "partial_images": false,
    "compression_formats": ["jpeg", "webp"],
    "parameter_values": {
      "quality": ["auto"],
      "background": ["auto"],
      "partial_images": [0],
      "moderation": ["auto"],
      "input_fidelity": []
    },
    "exact_size_method": "resize_to_fill",
    "compression_requirements": {
      "webp": ["ffmpeg"]
    }
  },
  "generation_settings": {
    "title": "ChatGPT 生成配置",
    "description": "保存后用于新的图片任务。模型留空时由 ChatGPT 按当前账号自动选择；指定模型会在任务开始时与账号可用模型列表核对。",
    "notice": "当前真实网页协议已验证 Standard 和 Extended；未验证或账号无权限的档位不会显示，避免请求被 ChatGPT 拒绝。",
    "fields": [
      {
        "key": "model",
        "type": "text",
        "label": "模型标识",
        "hint": "留空最稳妥，例如 gpt-5-6",
        "placeholder": "留空，跟随 ChatGPT 自动选择",
        "default": ""
      },
      {
        "key": "thinking_effort",
        "type": "select",
        "label": "思考深度",
        "hint": "深度越高，通常等待越久",
        "default": "extended",
        "options": [
          {
            "value": "",
            "label": "跟随 ChatGPT 默认策略"
          },
          {
            "value": "standard",
            "label": "标准思考（Medium）"
          },
          {
            "value": "extended",
            "label": "深度思考（High）"
          }
        ]
      }
    ]
  },
  "failure_policy": [
    {
      "contains_any": ["rate_limit_exceeded", "HTTP 429", "生成过于频繁"],
      "state": "cooldown",
      "cooldown_from_message": true,
      "cooldown_seconds": -1
    },
    {
      "contains_any": [
        "quota_exhausted",
        "image generations requests",
        "limit resets in",
        "usage limit",
        "insufficient_quota",
        "limit exceeded"
      ],
      "state": "daily_quota_exhausted",
      "cooldown_from_message": true,
      "cooldown_seconds": -1
    }
  ],
  "failure_strategy": [
    {
      "contains_any": ["account_model_unavailable"],
      "category": "account_model_unavailable",
      "retry_action": "failover",
      "usage_consumed": false
    },
    {
      "contains_any": ["verification_required"],
      "category": "verification_required",
      "retry_action": "fail",
      "account_state": "verification_required",
      "usage_consumed": false
    },
    {
      "contains_any": [
        "missing_input",
        "invalid_input",
        "unsupported_speed",
        "unsupported_instructions",
        "unsupported_voice",
        "unsupported_format"
      ],
      "category": "invalid_request",
      "retry_action": "fail",
      "usage_consumed": false
    },
    {
      "contains_any": ["LOGIN_EXPIRED", "HTTP 401"],
      "category": "login_expired",
      "retry_action": "failover",
      "account_state": "login_expired",
      "usage_consumed": false
    },
    {
      "contains_any": ["rate_limit_exceeded", "HTTP 429", "生成过于频繁"],
      "category": "account_rate_limited",
      "retry_action": "failover",
      "account_state": "cooldown",
      "cooldown_from_message": true,
      "cooldown_seconds": -1,
      "usage_consumed": false
    },
    {
      "contains_any": [
        "quota_exhausted",
        "image generations requests",
        "limit resets in",
        "usage limit",
        "insufficient_quota",
        "limit exceeded"
      ],
      "category": "quota_exhausted",
      "retry_action": "failover",
      "account_state": "daily_quota_exhausted",
      "cooldown_from_message": true,
      "cooldown_seconds": -1,
      "usage_consumed": false
    },
    {
      "contains_any": [
        "AUTH_INCONCLUSIVE",
        "generation_timeout",
        "temporary_unavailable",
        "timeout",
        "connection reset",
        "HTTP 500",
        "HTTP 502",
        "HTTP 503",
        "HTTP 504"
      ],
      "category": "transient_network",
      "retry_action": "same_account_retry",
      "same_error_threshold": 3,
      "threshold_cooldown_seconds": 600,
      "usage_consumed": false
    }
  ],
  "verification": {
    "trigger_contains_any": [],
    "ignore_contains_any": [],
    "captcha_selectors": []
  },
  "login_detection": {
    "method": "js_script",
    "script_files": ["@shared/chatgpt_auth_ui.js", "@shared/chatgpt_check_login.js"],
    "await_promise": true
  },
  "login_credential_capture": {
    "script_files": ["@shared/chatgpt_auth_ui.js", "capture_auth.js"],
    "await_promise": true,
    "file_name": "auth.json",
    "cookie_urls": ["https://chatgpt.com/"]
  },
  "watermark": {
    "has_watermark": false,
    "removal_strategy": "none"
  },
  "flows": {
    "generate_image": {
      "steps": [
        {
          "_comment": "纯 HTTP 执行 ChatGPT 普通会话生图；浏览器仅在添加或重新登录账号时使用",
          "action": "plugin.run_js",
          "script_files": [
            "@shared/api_text_attachments.js",
            "@shared/api_text_responses.js",
            "@shared/api_session.js",
            "auth.js",
            "network_profile.js",
            "startup.js",
            "sentinel_vm.js",
            "sentinel.js",
            "reference_upload.js",
            "poll_retry.js",
            "conversation.js",
            "conversation_results.js",
            "generate_image.js"
          ],
          "timeout_ms": 14400000,
          "save_as": "result"
        }
      ]
    },
    "check_account": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": [
            "@shared/api_session.js",
            "auth.js",
            "network_profile.js",
            "startup.js",
            "quota_status.js",
            "check_account.js"
          ],
          "timeout_ms": 60000,
          "save_as": "health"
        }
      ]
    },
    "generate_text": {
      "steps": [
        {
          "_comment": "把通用本地文本 request 转换为 ChatGPT 平台协议；不包含剧本提示词或业务格式逻辑",
          "action": "plugin.run_js",
          "script_files": [
            "@shared/api_session.js",
            "auth.js",
            "network_profile.js",
            "startup.js",
            "sentinel_vm.js",
            "sentinel.js",
            "conversation.js",
            "conversation_results.js",
            "@shared/api_text_attachments.js",
            "@shared/api_text_responses.js",
            "reference_upload.js",
            "poll_retry.js",
            "text_conversation.js",
            "@shared/api_text_media.js",
            "text_updates.js",
            "text_media.js",
            "generate_text.js"
          ],
          "timeout_ms": 14400000,
          "save_as": "result"
        }
      ]
    },
    "list_models": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "network_profile.js", "conversation.js", "list_models.js"],
          "timeout_ms": 60000
        }
      ]
    },
    "generate_audio": {
      "steps": [
        {
          "_comment": "纯 HTTP 执行 ChatGPT TTS 会话并下载真实音频；不启动本地 HTTP Server",
          "action": "plugin.run_js",
          "script_files": [
            "@shared/api_text_attachments.js",
            "@shared/api_text_responses.js",
            "@shared/api_session.js",
            "auth.js",
            "network_profile.js",
            "startup.js",
            "sentinel_vm.js",
            "sentinel.js",
            "conversation.js",
            "conversation_results.js",
            "poll_retry.js",
            "@shared/api_text_media.js",
            "text_media.js",
            "text_updates.js",
            "text_conversation.js",
            "audio_speech.js",
            "generate_audio.js"
          ],
          "timeout_ms": 14400000,
          "save_as": "result",
          "submission_boundary": true
        }
      ]
    },
    "transcribe_audio": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "network_profile.js", "transcribe_audio.js"],
          "timeout_ms": 300000
        }
      ]
    },
    "translate_audio": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": [
