{
  "platform_id": "codex",
  "display_name": "codex",
  "sort_order": 40,
  "adapter_mode": "api",
  "login_url": "https://auth.openai.com/oauth/authorize",
  "workspace_url": "https://chatgpt.com/",
  "models": [
    {
      "model_id": "codex",
      "display_name": "codex",
      "task_kind": "image",
      "aliases": ["gpt-image-2"],
      "alias_priority": 40
    }
  ],
  "tiers": {
    "free": {
      "display_name": "默认用户",
      "is_default": true,
      "concurrency_limit": 1,
      "daily_limit": 40,
      "total_limit": 0,
      "cooldown_seconds": 30
    }
  },
  "image_capabilities": {
    "supports_generation": true,
    "supports_edit": true,
    "supports_mask": true,
    "max_reference_images": 16,
    "supported_output_formats": ["png", "jpeg", "webp"]
  },
  "failure_policy": [
    {
      "contains_any": [
        "rate_limit_exceeded",
        "you're generating images too quickly",
        "you’re generating images too quickly",
        "please wait for",
        "rate limited",
        "rate limit",
        "http 429"
      ],
      "state": "cooldown",
      "cooldown_from_message": true,
      "cooldown_seconds": -1
    },
    {
      "contains_any": ["free plan limit", "image generations requests", "limit resets in"],
      "state": "disabled"
    }
  ],
  "verification": {
    "trigger_contains_any": [],
    "ignore_contains_any": [],
    "captcha_selectors": []
  },
  "watermark": {
    "has_watermark": false,
    "removal_strategy": "none"
  },
  "flows": {
    "add_account": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_file": "login.js",
          "timeout_ms": 300000,
          "save_as": "account"
        }
      ]
    },
    "relogin_account": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_file": "login.js",
          "timeout_ms": 300000,
          "save_as": "account"
        }
      ]
    },
    "generate_image": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "retry.js", "generate_image.js"],
          "timeout_ms": 1800000,
          "save_as": "poll"
        }
      ]
    },
    "check_account": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "check_account.js"],
          "timeout_ms": 60000,
          "save_as": "health"
        }
      ]
    }
  },
  "registration": {
    "enabled": false
  }
}
