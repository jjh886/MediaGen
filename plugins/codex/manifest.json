{
  "platform_id": "codex",
  "display_name": "codex",
  "sort_order": 20,
  "adapter_mode": "api",
  "login_url": "https://auth.openai.com/oauth/authorize",
  "workspace_url": "https://chatgpt.com/",
  "models": [
    {
      "model_id": "codex",
      "display_name": "codex",
      "task_kind": "image",
      "aliases": ["gpt-image-2"],
      "alias_priority": 40
    }
  ],
  "tiers": {
    "free": {
      "display_name": "默认用户",
      "is_default": true,
      "concurrency_limit": 1,
      "daily_limit": 40,
      "total_limit": 0,
      "cooldown_seconds": 30,
      "task_interval_seconds": 0
    }
  },
  "image_capabilities": {
    "supports_generation": true,
    "supports_edit": true,
    "supports_mask": true,
    "max_reference_images": 16,
    "supported_output_formats": ["png", "jpeg", "webp"]
  },
  "failure_policy": [
    {
      "contains_any": [
        "rate_limit_exceeded",
        "you're generating images too quickly",
        "you’re generating images too quickly",
        "please wait for",
        "rate limited",
        "rate limit",
        "http 429"
      ],
      "state": "cooldown",
      "cooldown_from_message": true,
      "cooldown_seconds": -1
    },
    {
      "contains_any": ["free plan limit", "image generations requests", "limit resets in"],
      "state": "disabled"
    }
  ],
  "failure_strategy": [
    {
      "contains_any": [
        "safety_violations",
        "safety system",
        "invalid",
        "bad request",
        "unsupported"
      ],
      "category": "invalid_request",
      "retry_action": "fail",
      "usage_consumed": false
    },
    {
      "contains_any": ["LOGIN_EXPIRED", "http 401", "http 403", "request_forbidden"],
      "category": "login_expired",
      "retry_action": "failover",
      "account_state": "login_expired",
      "usage_consumed": false
    },
    {
      "contains_any": ["AUTH_INCONCLUSIVE", "retryable error", "timeout", "connection reset"],
      "category": "transient_network",
      "retry_action": "same_account_retry",
      "same_error_threshold": 3,
      "threshold_cooldown_seconds": 600,
      "usage_consumed": false
    },
    {
      "contains_any": [
        "rate_limit_exceeded",
        "you're generating images too quickly",
        "you’re generating images too quickly",
        "please wait for",
        "rate limited",
        "rate limit",
        "http 429"
      ],
      "category": "account_rate_limited",
      "retry_action": "failover",
      "account_state": "cooldown",
      "cooldown_from_message": true,
      "cooldown_seconds": -1,
      "usage_consumed": false
    },
    {
      "contains_any": ["free plan limit", "image generations requests", "limit resets in"],
      "category": "quota_exhausted",
      "retry_action": "failover",
      "account_state": "daily_quota_exhausted",
      "cooldown_from_message": true,
      "usage_consumed": false
    }
  ],
  "verification": {
    "trigger_contains_any": [],
    "ignore_contains_any": [],
    "captcha_selectors": []
  },
  "login_oauth_pkce": {
    "auth_url": "https://auth.openai.com/oauth/authorize",
    "token_url": "https://auth.openai.com/oauth/token",
    "client_id": "app_EMoamEEZ73f0CkXaXp7hrann",
    "scope": "openid profile email offline_access",
    "redirect_uri": "http://localhost:1455/auth/callback",
    "token_script_file": "finish_oauth_login.js",
    "auth_params": {
      "prompt": "login",
      "id_token_add_organizations": "true",
      "codex_cli_simplified_flow": "true"
    }
  },
  "login_detection": {
    "method": "plugin_script",
    "script_file": "finish_oauth_login.js"
  },
  "watermark": {
    "has_watermark": false,
    "removal_strategy": "none"
  },
  "flows": {
    "add_account": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_file": "login.js",
          "timeout_ms": 300000,
          "save_as": "account"
        }
      ]
    },
    "relogin_account": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_file": "login.js",
          "timeout_ms": 300000,
          "save_as": "account"
        }
      ]
    },
    "generate_image": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "retry.js", "image_response.js", "generate_image.js"],
          "timeout_ms": 1800000,
          "save_as": "poll"
        }
      ]
    },
    "check_account": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "check_account.js"],
          "timeout_ms": 60000,
          "save_as": "health"
        }
      ]
    }
  },
  "registration": {
    "enabled": false
  }
}
