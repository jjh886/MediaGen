  "tiers": {
    "standard": {
      "display_name": "Google 账号",
      "is_default": true,
      "text_concurrency_limit": 1
    }
  },
  "protected_json_files": ["auth.json", "oauth-client.json", "login.json"],
  "capabilities": {
    "actions": [
      "http.request",
      "http.sse_request",
      "file.read_json",
      "file.write_json",
      "lock.acquire",
      "lock.release",
      "crypto.random_uuid",
      "crypto.sha256_hex",
      "time.sleep",
      "process.spawn",
      "crypto.random_base64url",
      "crypto.sha256_base64url"
    ],
    "network_hosts": [
      "oauth2.googleapis.com",
      "www.googleapis.com",
      "cloudcode-pa.googleapis.com",
      "127.0.0.1",
      "daily-cloudcode-pa.googleapis.com"
    ],
    "context_fields": ["profile_dir", "request", "model_capabilities", "refresh_quota"]
  },
  "login_detection": {
    "method": "plugin_script",
    "script_files": ["auth.js", "loopback.js", "finish_login.js"]
  },
  "flows": {
    "add_account": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "loopback.js", "finish_login.js"],
          "timeout_ms": 90000,
          "save_as": "account"
        }
      ]
    },
    "relogin_account": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "loopback.js", "finish_login.js"],
          "timeout_ms": 90000,
          "save_as": "account"
        }
      ]
    },
    "check_account": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "check_account.js"],
          "timeout_ms": 90000,
          "save_as": "health"
        }
      ]
    },
    "list_models": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": [
            "@shared/api_text_attachments.js",
            "auth.js",
            "models.js",
            "list_models.js"
          ],
          "timeout_ms": 90000,
          "save_as": "result"
        }
      ]
    },
    "generate_text": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": [
            "@shared/api_text_attachments.js",
            "@shared/api_text_responses.js",
            "auth.js",
            "models.js",
            "generate_text.js"
          ],
          "timeout_ms": 660000,
          "save_as": "result"
        }
      ]
    }
  },
  "failure_strategy": [
    {
      "contains_any": ["account_model_unavailable"],
      "category": "account_model_unavailable",
      "retry_action": "failover",
      "usage_consumed": false
    },
    {
      "contains_any": ["LOGIN_EXPIRED"],
      "category": "login_expired",
      "retry_action": "failover",
      "account_state": "login_expired",
      "usage_consumed": false
    },
    {
      "contains_any": ["http 429"],
      "category": "account_rate_limited",
      "retry_action": "failover",
      "account_state": "cooldown",
      "cooldown_seconds": 60,
      "usage_consumed": false
    }
  ],
  "registration": {
    "enabled": false
  },
  "login_prepare": {
    "script_files": ["auth.js", "loopback.js", "start_login.js"]
  }
}
