{
  "schema_version": 1,
  "adapter_mode": "api",
  "failure_strategy": [
    {
      "contains_any": ["verification_required", "needs_verification"],
      "category": "verification_required",
      "retry_action": "failover",
      "account_state": "verification_required",
      "usage_consumed": false
    },
    {
      "contains_any": [
        "missing_input",
        "invalid_input",
        "unsupported_speed",
        "unsupported_instructions",
        "unsupported_voice",
        "unsupported_format"
      ],
      "category": "invalid_request",
      "retry_action": "fail",
      "usage_consumed": false
    },
    {
      "contains_any": ["LOGIN_EXPIRED", "HTTP 401"],
      "category": "login_expired",
      "retry_action": "failover",
      "account_state": "login_expired",
      "usage_consumed": false
    },
    {
      "contains_any": ["rate_limit_exceeded", "HTTP 429", "生成过于频繁"],
      "category": "account_rate_limited",
      "retry_action": "failover",
      "account_state": "cooldown",
      "cooldown_from_message": true,
      "cooldown_seconds": -1,
      "usage_consumed": false
    },
    {
      "contains_any": [
        "quota_exhausted",
        "image generations requests",
        "limit resets in",
        "usage limit",
        "insufficient_quota",
        "limit exceeded"
      ],
      "category": "quota_exhausted",
      "retry_action": "failover",
      "account_state": "daily_quota_exhausted",
      "cooldown_from_message": true,
      "cooldown_seconds": -1,
      "usage_consumed": false
    },
    {
      "contains_any": [
        "AUTH_INCONCLUSIVE",
        "generation_timeout",
        "temporary_unavailable",
        "timeout",
        "connection reset",
        "HTTP 500",
        "HTTP 502",
        "HTTP 503",
        "HTTP 504"
      ],
      "category": "transient_network",
      "retry_action": "same_account_retry",
      "same_error_threshold": 3,
      "threshold_cooldown_seconds": 600,
      "usage_consumed": false
    }
  ],
  "verification": {
    "trigger_contains_any": [],
    "ignore_contains_any": [],
    "captcha_selectors": []
  },
  "registration": {
    "enabled": false
  },
  "version": "1.1.3",
  "platform_id": "deepseek-api",
  "display_name": "DeepSeek",
  "sort_order": 60,
  "login_url": "https://chat.deepseek.com/",
  "workspace_url": "https://chat.deepseek.com/",
  "capabilities": {
    "actions": [
      "browser.run_script",
      "file.read_json",
      "file.write_json",
      "file.write_base64",
      "http.request",
      "http.sse_request",
      "time.sleep",
      "crypto.wasm_execute",
      "crypto.base64_encode_utf8"
    ],
    "network_hosts": ["deepseek.com"],
    "context_fields": [
      "profile_dir",
      "workspace_dir",
      "request",
      "model_id",
      "model_capabilities",
      "reasoning_effort",
      "prompt",
      "platform_config",
      "image_aspect_ratio",
      "video_aspect_ratio",
      "generation_options",
      "ref_image_dataurls",
      "ref_image_locals",
      "ref_video_locals",
      "ref_audio_locals",
      "video_duration",
      "max_images"
    ]
  },
