  "tiers": {
    "free": {
      "display_name": "OAuth 账号",
      "is_default": true,
      "concurrency_limit": 1,
      "daily_limit": 0,
      "total_limit": 0,
      "cooldown_seconds": 30,
      "task_interval_seconds": 0,
      "text_concurrency_limit": 0,
      "text_daily_limit": 0,
      "text_total_limit": 0
    }
  },
  "image_capabilities": {
    "supports_generation": true,
    "supports_edit": true,
    "supports_mask": false,
    "supports_variation": false,
    "max_reference_images": 3,
    "supported_output_formats": ["png", "jpeg", "webp"],
    "streaming": true,
    "partial_images": false,
    "compression_formats": ["jpeg", "webp"],
    "compression_requirements": {
      "webp": ["ffmpeg"]
    },
    "exact_size_method": "resize_to_fill",
    "parameter_values": {
      "quality": ["auto"],
      "background": ["auto", "opaque"],
      "partial_images": [0],
      "moderation": ["auto"],
      "input_fidelity": []
    }
  },
  "video_capabilities": {
    "supports_generation": true,
    "supports_image_reference": true,
    "max_reference_images": 7,
    "min_duration_seconds": 1,
    "max_duration_seconds": 15,
    "default_duration_seconds": 6,
    "default_size": "1280x720",
    "supported_sizes": ["1280x720", "720x1280", "1920x1080", "1080x1920"],
    "supported_aspect_ratios": ["16:9", "9:16"]
  },
  "flows": {
    "generate_text": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "text.js", "generate_text.js"],
          "timeout_ms": 660000
        }
      ]
    },
    "list_models": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "text.js", "list_models.js"],
          "timeout_ms": 60000
        }
      ]
    },
    "generate_image": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "generate_image.js"],
          "timeout_ms": 600000
        }
      ]
    },
    "generate_video": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "generate_video.js"],
          "timeout_ms": 1800000
        }
      ]
    },
    "generate_audio": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "generate_audio.js"],
          "timeout_ms": 300000
        }
      ]
    },
    "transcribe_audio": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "transcribe_audio.js"],
          "timeout_ms": 300000
        }
      ]
    },
    "connect_realtime": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "connect_realtime.js"],
          "timeout_ms": 60000
        }
      ]
    },
    "check_account": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "check_account.js"],
          "timeout_ms": 60000
        }
      ]
    }
  },
  "registration": {
    "enabled": false
  },
  "failure_strategy": [
    {
      "contains_any": ["LOGIN_EXPIRED"],
      "category": "login_expired",
      "retry_action": "failover",
      "account_state": "login_expired",
      "usage_consumed": false
    },
    {
      "contains_any": ["rate_limit_exceeded"],
      "category": "account_rate_limited",
      "retry_action": "failover",
      "account_state": "cooldown",
      "cooldown_seconds": 60,
      "usage_consumed": false
    },
    {
      "contains_any": ["invalid_input", "account_permission_denied"],
      "category": "invalid_request",
      "retry_action": "fail",
      "usage_consumed": false
    }
  ]
}
