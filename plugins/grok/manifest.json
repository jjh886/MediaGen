    "supported_aspect_ratios": ["16:9", "9:16"]
  },
  "flows": {
    "generate_text": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "text.js", "generate_text.js"],
          "timeout_ms": 660000
        }
      ]
    },
    "list_models": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "text.js", "list_models.js"],
          "timeout_ms": 60000
        }
      ]
    },
    "generate_image": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "generate_image.js"],
          "timeout_ms": 600000
        }
      ]
    },
    "generate_video": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "generate_video.js"],
          "timeout_ms": 1800000
        }
      ]
    },
    "generate_audio": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "generate_audio.js"],
          "timeout_ms": 300000
        }
      ]
    },
    "transcribe_audio": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "transcribe_audio.js"],
          "timeout_ms": 300000
        }
      ]
    },
    "connect_realtime": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "connect_realtime.js"],
          "timeout_ms": 60000
        }
      ]
    },
    "check_account": {
      "steps": [
        {
          "action": "plugin.run_js",
          "script_files": ["auth.js", "quota.js", "check_account.js"],
          "timeout_ms": 60000
        }
      ]
    }
  },
  "registration": {
    "enabled": false
  },
  "failure_strategy": [
    {
      "contains_any": ["insufficient_quota"],
      "category": "insufficient_quota",
      "retry_action": "fail",
      "usage_consumed": false
    },
    {
      "contains_any": ["account_model_unavailable"],
      "category": "account_model_unavailable",
      "retry_action": "failover",
      "usage_consumed": false
    },
    {
      "contains_any": ["account_permission_denied"],
      "category": "permission_denied",
      "retry_action": "fail",
      "usage_consumed": false
    },
    {
      "contains_any": ["LOGIN_EXPIRED"],
      "category": "login_expired",
      "retry_action": "failover",
      "account_state": "login_expired",
      "usage_consumed": false
    },
    {
      "contains_any": ["rate_limit_exceeded"],
      "category": "account_rate_limited",
      "retry_action": "failover",
      "account_state": "cooldown",
      "cooldown_seconds": 60,
      "usage_consumed": false
    },
    {
      "contains_any": ["invalid_input"],
      "category": "invalid_request",
      "retry_action": "fail",
      "usage_consumed": false
    }
  ],
  "version": "1.0.4"
}
