        "input_schema": {
          "type": "object",
          "required": ["model"],
          "properties": {
            "model": {
              "type": "string"
            },
            "session": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "realtime"
                },
                "instructions": {
