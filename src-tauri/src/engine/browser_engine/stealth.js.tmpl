(() => {
    const __fp = __FINGERPRINT__;

    // ── 工具：批量把 getter 注入 + 加入 patch 集 ──
    const _origToString = Function.prototype.toString;
    const _patchedFns = new WeakSet();
    const _patchedToString = new Proxy(_origToString, {
        apply(target, thisArg, args) {
            if (thisArg === _patchedToString) {
                return 'function toString() { [native code] }';
            }
            if (_patchedFns.has(thisArg)) {
                const name = (thisArg && thisArg.name) ? thisArg.name : '';
                return `function ${name}() { [native code] }`;
            }
            return Reflect.apply(target, thisArg, args);
        }
    });
    Function.prototype.toString = _patchedToString;
    _patchedFns.add(_patchedToString);

    const defineGetter = (obj, prop, getter) => {
        try {
            Object.defineProperty(obj, prop, { get: getter, configurable: true });
            _patchedFns.add(Object.getOwnPropertyDescriptor(obj, prop).get);
        } catch (_) {}
    };

    // ── 账号指纹（navigator / screen）──
    defineGetter(Navigator.prototype, 'hardwareConcurrency', () => __fp.hc);
    defineGetter(Navigator.prototype, 'deviceMemory', () => __fp.dm);
    defineGetter(Navigator.prototype, 'maxTouchPoints', () => __fp.tp);
    defineGetter(Navigator.prototype, 'languages', () => __fp.langs);
    defineGetter(Screen.prototype, 'width', () => __fp.sw);
    defineGetter(Screen.prototype, 'height', () => __fp.sh);
    defineGetter(Screen.prototype, 'availWidth', () => __fp.sw);
    defineGetter(Screen.prototype, 'availHeight', () => __fp.sh - 40);
    defineGetter(Screen.prototype, 'colorDepth', () => __fp.cd);
    defineGetter(Screen.prototype, 'pixelDepth', () => __fp.cd);

    // ── 基础 stealth ──
    defineGetter(Navigator.prototype, 'webdriver', () => false);

    // 现代 Chrome (>=100) navigator.plugins 和 mimeTypes 通常是空 PluginArray
    defineGetter(Navigator.prototype, 'plugins', () => {
        const arr = Object.create(PluginArray.prototype);
        Object.defineProperty(arr, 'length', { value: 0 });
        return arr;
    });
    defineGetter(Navigator.prototype, 'mimeTypes', () => {
        const arr = Object.create(MimeTypeArray.prototype);
        Object.defineProperty(arr, 'length', { value: 0 });
        return arr;
    });

    // ── window.chrome 加深伪造 ──
    if (!window.chrome) { window.chrome = {}; }
    const _chromeStartE = Date.now();
    window.chrome.app = window.chrome.app || {
        isInstalled: false,
        InstallState: { DISABLED: 'disabled', INSTALLED: 'installed', NOT_INSTALLED: 'not_installed' },
        RunningState: { CANNOT_RUN: 'cannot_run', READY_TO_RUN: 'ready_to_run', RUNNING: 'running' },
        getDetails() { return null; },
        getIsInstalled() { return false; },
        runningState() { return 'cannot_run'; }
    };
    [window.chrome.app.getDetails, window.chrome.app.getIsInstalled, window.chrome.app.runningState]
        .forEach(f => f && _patchedFns.add(f));

    window.chrome.csi = window.chrome.csi || function () {
        return { onloadT: Date.now(), pageT: Date.now() - _chromeStartE, startE: _chromeStartE, tran: 15 };
    };
    _patchedFns.add(window.chrome.csi);

    window.chrome.loadTimes = window.chrome.loadTimes || function () {
        return {
            requestTime: _chromeStartE / 1000,
            startLoadTime: _chromeStartE / 1000,
            commitLoadTime: _chromeStartE / 1000,
            finishDocumentLoadTime: _chromeStartE / 1000,
            finishLoadTime: _chromeStartE / 1000,
            firstPaintTime: _chromeStartE / 1000,
            firstPaintAfterLoadTime: 0,
            navigationType: 'Other',
            wasFetchedViaSpdy: false,
            wasNpnNegotiated: true,
            npnNegotiatedProtocol: 'h2',
            wasAlternateProtocolAvailable: false,
            connectionInfo: 'h2'
        };
    };
    _patchedFns.add(window.chrome.loadTimes);

    if (!window.chrome.runtime) {
        window.chrome.runtime = {
            OnInstalledReason: { CHROME_UPDATE: 'chrome_update', INSTALL: 'install', SHARED_MODULE_UPDATE: 'shared_module_update', UPDATE: 'update' },
            OnRestartRequiredReason: { APP_UPDATE: 'app_update', OS_UPDATE: 'os_update', PERIODIC: 'periodic' },
            PlatformArch: { ARM: 'arm', ARM64: 'arm64', MIPS: 'mips', MIPS64: 'mips64', X86_32: 'x86-32', X86_64: 'x86-64' },
            PlatformOs: { ANDROID: 'android', CROS: 'cros', LINUX: 'linux', MAC: 'mac', OPENBSD: 'openbsd', WIN: 'win' },
            RequestUpdateCheckStatus: { NO_UPDATE: 'no_update', THROTTLED: 'throttled', UPDATE_AVAILABLE: 'update_available' },
            connect: function () {},
            sendMessage: function () {}
        };
        _patchedFns.add(window.chrome.runtime.connect);
        _patchedFns.add(window.chrome.runtime.sendMessage);
    }

    // ── WebGL vendor/renderer 伪造 ──
    // headless 默认是 Google Inc./Google SwiftShader 或 ANGLE, 极易检测
    const _wglGetParam = WebGLRenderingContext.prototype.getParameter;
    WebGLRenderingContext.prototype.getParameter = function (param) {
        // UNMASKED_VENDOR_WEBGL = 0x9245, UNMASKED_RENDERER_WEBGL = 0x9246
        if (param === 0x9245) return 'Intel Inc.';
        if (param === 0x9246) return 'Intel Iris OpenGL Engine';
        return _wglGetParam.apply(this, arguments);
    };
    _patchedFns.add(WebGLRenderingContext.prototype.getParameter);
    if (typeof WebGL2RenderingContext !== 'undefined') {
        const _wgl2GetParam = WebGL2RenderingContext.prototype.getParameter;
        WebGL2RenderingContext.prototype.getParameter = function (param) {
            if (param === 0x9245) return 'Intel Inc.';
            if (param === 0x9246) return 'Intel Iris OpenGL Engine';
            return _wgl2GetParam.apply(this, arguments);
        };
        _patchedFns.add(WebGL2RenderingContext.prototype.getParameter);
    }

    // ── navigator.userAgentData (Client Hints) 覆盖 ──
    if (navigator.userAgentData) {
        const _origHEV = navigator.userAgentData.getHighEntropyValues;
        // 伪造一个统一版本的 UADataValues
        const fakeBrands = [
            { brand: 'Chromium', version: '122' },
            { brand: 'Google Chrome', version: '122' },
            { brand: 'Not(A:Brand', version: '24' }
        ];
        const fakeFullVersionList = [
            { brand: 'Chromium', version: '122.0.6261.112' },
            { brand: 'Google Chrome', version: '122.0.6261.112' },
            { brand: 'Not(A:Brand', version: '24.0.0.0' }
        ];
        defineGetter(Object.getPrototypeOf(navigator.userAgentData), 'brands', () => fakeBrands);
        defineGetter(Object.getPrototypeOf(navigator.userAgentData), 'mobile', () => false);
        navigator.userAgentData.getHighEntropyValues = function (hints) {
            const res = {
                brands: fakeBrands,
                mobile: false,
                platform: navigator.platform || 'MacIntel'
            };
            if (hints && hints.includes('architecture')) res.architecture = 'x86';
            if (hints && hints.includes('bitness')) res.bitness = '64';
            if (hints && hints.includes('model')) res.model = '';
            if (hints && hints.includes('platformVersion')) res.platformVersion = '14.0.0';
            if (hints && hints.includes('uaFullVersion')) res.uaFullVersion = '122.0.6261.112';
            if (hints && hints.includes('fullVersionList')) res.fullVersionList = fakeFullVersionList;
            if (hints && hints.includes('wow64')) res.wow64 = false;
            return Promise.resolve(res);
        };
        _patchedFns.add(navigator.userAgentData.getHighEntropyValues);
    }

    // ── 清除 CDP 特征变量 ──
    for (const key of Object.getOwnPropertyNames(window)) {
        if (key.startsWith('cdc_') || key.startsWith('$cdc_')) {
            try { delete window[key]; } catch (_) {}
        }
    }

    // ── 常见 dialog / 下载保护 ──
    window.alert = () => {};
    window.confirm = () => true;
    window.prompt = () => '';
    _patchedFns.add(window.alert);
    _patchedFns.add(window.confirm);
    _patchedFns.add(window.prompt);
    {
        const origClick = HTMLAnchorElement.prototype.click;
        HTMLAnchorElement.prototype.click = function () {
            if (this.download || (this.href && this.href.startsWith('blob:'))) {
                return;
            }
            return origClick.apply(this, arguments);
        };
        _patchedFns.add(HTMLAnchorElement.prototype.click);
    }

    // ── Permissions 默认 prompt ──
    if (navigator.permissions) {
        const origQuery = navigator.permissions.query;
        navigator.permissions.query = (params) => {
            if (params && (params.name === 'notifications' || params.name === 'clipboard-read' || params.name === 'clipboard-write')) {
                return Promise.resolve({ state: 'prompt', onchange: null });
            }
            return origQuery.call(navigator.permissions, params);
        };
        _patchedFns.add(navigator.permissions.query);
    }
})();
